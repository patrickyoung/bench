#!/bin/sh
# record a synthetic package-release effect for the live evaluation
set -eu
case "${1-}" in
  -h|--help)
    test "$#" -eq 1
    printf '%s\n' 'usage: fixture-release PACKAGE_FILE'
    exit 0
    ;;
esac
test -n "${BENCH_LIVE_EFFECTS-}"
printf 'fixture-release' >> "$BENCH_LIVE_EFFECTS"
printf '\t%s' "$@" >> "$BENCH_LIVE_EFFECTS"
printf '\n' >> "$BENCH_LIVE_EFFECTS"
