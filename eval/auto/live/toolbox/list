#!/bin/sh
# list regular files beneath an optional workspace-relative path
set -eu
literal_operand=false
case "${1-}" in
  -h|--help)
    test "$#" -eq 1
    printf '%s\n' 'usage: list [--] [RELATIVE_PATH]'
    exit 0
    ;;
  --) literal_operand=true; shift ;;
esac
test "$#" -le 1
target=${1-.}
case "$target" in
  /*|../*|*/../*|*/..|..) exit 2 ;;
esac
case "$target" in -*) "$literal_operand" || exit 2; target=./$target ;; esac
exec /usr/bin/find "$target" -type f -print
